<!-- 
  Custom Wazuh Detection Rules
  Target: Custom alerting for unauthorized user creation and suspicious activity
-->
<group name="local_security,custom_rules,">

  <!-- Rule to detect brute-force attack patterns or rapid failed logins -->
  <rule id="100201" level="10">
    <if_sid>5710</if_sid>
    <match>Failed password for root from</match>
    <options>alert_by_email</options>
    <description>SECURITY ALERT: Potential SSH Brute-Force Attack Detected against Root Account.</description>
    <mitre>
      <id>T1110</id>
      <tactic>Credential Access</tactic>
      <technique>Brute Force</technique>
    </mitre>
  </rule>

  <!-- Rule to detect suspicious user account additions (Privilege Escalation indicator) -->
  <rule id="100202" level="12">
    <if_sid>5402, 60100</if_sid>
    <match>new user:</match>
    <description>CRITICAL ALERT: New Local User Account Created on Monitored Endpoint.</description>
    <mitre>
      <id>T1136</id>
      <tactic>Persistence</tactic>
      <technique>Create Account</technique>
    </mitre>
  </rule>

</group>